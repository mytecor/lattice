diff --git a/src/pi-rpc/mcp-config.ts b/src/pi-rpc/mcp-config.ts
new file mode 100644
index 0000000..810d238
--- /dev/null
+++ b/src/pi-rpc/mcp-config.ts
@@ -0,0 +1,30 @@
+import type { McpServer } from '@agentclientprotocol/sdk'
+import { mkdtempSync, writeFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+// Each child owns its credentials/config. Never write ACP descriptors into the
+// shared Pi config or persist them in the ACP session map.
+export function prepareMcpConfig(servers: McpServer[] = []) {
+  if (!servers.length) return { args: [] as string[], cleanup: () => {} }
+  const extension = process.env.PI_ACP_MCP_EXTENSION
+  if (!extension) throw new Error('ACP MCP servers require PI_ACP_MCP_EXTENSION')
+  const mcpServers = Object.create(null)
+  for (const server of servers) {
+    if (Object.hasOwn(mcpServers, server.name)) throw new Error('Duplicate ACP MCP server name')
+    const connection = 'command' in server
+      ? { command: server.command, args: server.args, env: Object.fromEntries((server.env ?? []).map(e => [e.name, e.value])) }
+      : { url: server.url, transport: server.type === 'sse' ? 'sse' : 'http', headers: Object.fromEntries((server.headers ?? []).map(h => [h.name, h.value])) }
+    mcpServers[server.name] = { ...connection, lifecycle: 'eager', directTools: true }
+  }
+  const dir = mkdtempSync(join(tmpdir(), 'pi-acp-mcp-'))
+  const cleanup = () => rmSync(dir, { recursive: true, force: true })
+  try {
+    const config = join(dir, 'mcp.json')
+    writeFileSync(config, JSON.stringify({ mcpServers }), { mode: 0o600 })
+    return { args: ['--extension', extension, '--mcp-config', config], cleanup }
+  } catch (error) {
+    cleanup()
+    throw error
+  }
+}
