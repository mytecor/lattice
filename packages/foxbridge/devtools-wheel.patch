+package bridge
+
+import (
+	"encoding/json"
+	"github.com/VulpineOS/foxbridge/pkg/cdp"
+	"testing"
+)
+
+func TestWheelProtocolUsesDedicatedJugglerCommand(t *testing.T) {
+	b, mb := newTestBridge()
+	b.sessions.Add(&cdp.SessionInfo{SessionID: "cdp-wheel", JugglerSessionID: "jug-wheel", Type: "page"})
+	mb.SetResponse("jug-wheel", "Page.dispatchWheelEvent", json.RawMessage(`{}`), nil)
+	_, err := b.handleInput(nil, &cdp.Message{ID: 1, SessionID: "cdp-wheel", Method: "Input.dispatchMouseEvent", Params: json.RawMessage(`{"type":"mouseWheel","x":100,"y":150,"deltaX":0,"deltaY":900,"modifiers":2}`)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	calls := mb.CallsForMethod("Page.dispatchWheelEvent")
+	if len(calls) != 1 || len(mb.CallsForMethod("Page.dispatchMouseEvent")) != 0 {
+		t.Fatal("wheel routed as a pointer event")
+	}
+	var payload map[string]float64
+	if err := json.Unmarshal(calls[0].Params, &payload); err != nil {
+		t.Fatal(err)
+	}
+	for key, want := range map[string]float64{"x": 100, "y": 150, "deltaX": 0, "deltaY": 900, "deltaZ": 0, "modifiers": 2} {
+		got, exists := payload[key]
+		if !exists || got != want {
+			t.Fatal(key, payload)
+		}
+	}
+}
