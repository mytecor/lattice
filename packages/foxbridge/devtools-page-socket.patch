+package cdp
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gorilla/websocket"
+)
+
+func TestPageSocketBindsSessionAndUsesTextFrames(t *testing.T) {
+	sessions := NewSessionManager()
+	sessions.Add(&SessionInfo{SessionID: "page-session", TargetID: "page-target", Type: "page"})
+	server := NewServer(9222, func(conn *Connection, msg *Message) {
+		if msg.SessionID != "page-session" {
+			t.Errorf("missing page session: %q", msg.SessionID)
+		}
+		conn.Send(&Message{ID: msg.ID, SessionID: msg.SessionID, Result: json.RawMessage(`{"value":42}`)})
+		event := &Message{Method: "Runtime.executionContextCreated", SessionID: msg.SessionID, Params: json.RawMessage(`{}`)}
+		conn.Send(event)
+		if event.SessionID != "page-session" {
+			t.Error("Send mutated shared broadcast event")
+		}
+	}, sessions)
+	httpServer := httptest.NewServer(server.mux())
+	defer httpServer.Close()
+	socket, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(httpServer.URL, "http")+"/devtools/page/page-target", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer socket.Close()
+	if err := socket.WriteJSON(map[string]any{"id": 1, "method": "Runtime.evaluate", "params": map[string]any{"expression": "6*7"}}); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		kind, data, err := socket.ReadMessage()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if kind != websocket.TextMessage {
+			t.Fatalf("DevTools expects JSON text, got frame %d", kind)
+		}
+		var message map[string]any
+		if err := json.Unmarshal(data, &message); err != nil {
+			t.Fatal(err)
+		}
+		if _, found := message["sessionId"]; found {
+			t.Fatal("page-root message leaked transport session", message)
+		}
+	}
+}
+
+func TestUnknownPageSocketIsRejected(t *testing.T) {
+	server := NewServer(9222, nil, NewSessionManager())
+	httpServer := httptest.NewServer(server.mux())
+	defer httpServer.Close()
+	socket, response, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(httpServer.URL, "http")+"/devtools/page/missing", nil)
+	if socket != nil {
+		socket.Close()
+	}
+	if err == nil || response == nil || response.StatusCode != 404 {
+		t.Fatal("unknown target accepted", err, response)
+	}
+}
