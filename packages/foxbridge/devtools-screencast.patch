+package bridge
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/VulpineOS/foxbridge/pkg/cdp"
+)
+
+func TestScreencastProtocolGeometry(t *testing.T) {
+	input := json.RawMessage(`{"data":"encoded-jpeg","deviceWidth":1824,"deviceHeight":1336,"timestamp":123.5}`)
+	var last float64
+	for i := 0; i < 2; i++ {
+		result, err := translateScreencastFrame(input)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var event struct {
+			Data      string
+			SessionID float64 `json:"sessionId"`
+			Metadata  map[string]float64
+		}
+		if err := json.Unmarshal(result, &event); err != nil {
+			t.Fatal(err)
+		}
+		if event.Data != "encoded-jpeg" || event.SessionID <= last {
+			t.Fatal("image or ack id lost", event)
+		}
+		last = event.SessionID
+		if event.Metadata["deviceWidth"] != 1824 || event.Metadata["deviceHeight"] != 1336 || event.Metadata["timestamp"] != 123.5 || event.Metadata["pageScaleFactor"] != 1 {
+			t.Fatal("CDP geometry missing", event.Metadata)
+		}
+	}
+	if _, err := translateScreencastFrame(json.RawMessage(`{"data":"jpeg"}`)); err == nil {
+		t.Fatal("zero-size frame accepted")
+	}
+}
+
+func TestScreencastProtocolAckUsesJugglerStreamID(t *testing.T) {
+	b, mb := newTestBridge()
+	for _, name := range []string{"a", "b"} {
+		b.sessions.Add(&cdp.SessionInfo{SessionID: "cdp-" + name, JugglerSessionID: "jug-" + name, TargetID: name, Type: "page"})
+		mb.SetResponse("jug-"+name, "Page.startScreencast", json.RawMessage(`{"screencastId":"stream-`+name+`"}`), nil)
+		if _, err := b.handlePage(nil, &cdp.Message{ID: 1, SessionID: "cdp-" + name, Method: "Page.startScreencast", Params: json.RawMessage(`{}`)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, name := range []string{"a", "b"} {
+		if _, err := b.handlePage(nil, &cdp.Message{ID: 2, SessionID: "cdp-" + name, Method: "Page.screencastFrameAck", Params: json.RawMessage(`{"sessionId":99}`)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	calls := mb.CallsForMethod("Page.screencastFrameAck")
+	if len(calls) != 2 {
+		t.Fatal("missing stream acknowledgements", len(calls))
+	}
+	for i, name := range []string{"a", "b"} {
+		var params map[string]any
+		if err := json.Unmarshal(calls[i].Params, &params); err != nil {
+			t.Fatal(err)
+		}
+		if len(params) != 1 || params["screencastId"] != "stream-"+name {
+			t.Fatal("CDP frame id leaked into Juggler ack", params)
+		}
+	}
+}
