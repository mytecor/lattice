+package bridge
+
+import (
+	"encoding/json"
+	"fmt"
+	"sync/atomic"
+)
+
+var screencastFrameSequence atomic.Int64
+
+// Juggler sends viewport geometry at the top level. CDP requires a metadata
+// object and an integer frame sessionId; passing the payload through leaves
+// Chrome's screencast canvas at 0x0 even though JPEG frames arrive.
+func translateScreencastFrame(params json.RawMessage) (json.RawMessage, error) {
+	var frame struct {
+		Data         string  `json:"data"`
+		DeviceWidth  float64 `json:"deviceWidth"`
+		DeviceHeight float64 `json:"deviceHeight"`
+		Timestamp    float64 `json:"timestamp"`
+	}
+	if err := json.Unmarshal(params, &frame); err != nil {
+		return nil, err
+	}
+	if frame.Data == "" || frame.DeviceWidth <= 0 || frame.DeviceHeight <= 0 {
+		return nil, fmt.Errorf("screencast frame is missing image or viewport geometry")
+	}
+	return json.Marshal(map[string]any{
+		"data":      frame.Data,
+		"sessionId": screencastFrameSequence.Add(1),
+		"metadata": map[string]any{
+			"deviceWidth": frame.DeviceWidth, "deviceHeight": frame.DeviceHeight,
+			"pageScaleFactor": 1, "offsetTop": 0, "scrollOffsetX": 0, "scrollOffsetY": 0,
+			"timestamp": frame.Timestamp,
+		},
+	})
+}
