+static bool public_payload(const char **p, sv_string *payload, char *err, size_t len) {
+    if (!json_expect(p, '{', err, len)) return false;
+    bool seen_format = false;
+    for (;;) {
+        sv_string key = {0}, value = {0};
+        if (!parse_json_string(p, &key, err, len)) return false;
+        bool is_payload = string_is(&key, "url") || string_is(&key, "data");
+        bool is_format = string_is(&key, "format");
+        free(key.s);
+        if ((!is_payload && !is_format) || (is_payload && payload->s) ||
+            (is_format && seen_format)) {
+            snprintf(err, len, "unknown or duplicate media field");
+            return false;
+        }
+        if (!json_expect(p, ':', err, len) || !parse_json_string(p, &value, err, len))
+            return false;
+        if (is_payload) {
+            *payload = value;
+        } else {
+            seen_format = true;
+            free(value.s);
+        }
+        skip_ws(p);
+        if (**p == '}') {
+            ++*p;
+            return payload->s && payload->len;
+        }
+        if (!json_expect(p, ',', err, len)) return false;
+    }
+}
+
+static char *prepare_public_media(const char *kind, const sv_string *input) {
+    const char *helper = getenv("EI_LATTICE_MEDIA_HELPER");
+    if (!helper || !*helper) return NULL;
+    FILE *source = tmpfile(), *dest = tmpfile();
+    char *result = NULL;
+    if (!source || !dest || fwrite(input->s, 1, input->len, source) != input->len ||
+        fseek(source, 0, SEEK_SET)) goto done;
+    posix_spawn_file_actions_t actions;
+    if (posix_spawn_file_actions_init(&actions)) goto done;
+    if (posix_spawn_file_actions_adddup2(&actions, fileno(source), STDIN_FILENO) ||
+        posix_spawn_file_actions_adddup2(&actions, fileno(dest), STDOUT_FILENO)) {
+        posix_spawn_file_actions_destroy(&actions);
+        goto done;
+    }
+    extern char **environ;
+    char *argv[] = {(char *)helper, (char *)kind, NULL};
+    pid_t child;
+    int rc = posix_spawn(&child, helper, &actions, NULL, argv, environ);
+    posix_spawn_file_actions_destroy(&actions);
+    if (rc) goto done;
+    int status;
+    do {
+        rc = waitpid(child, &status, 0);
+    } while (rc < 0 && errno == EINTR);
+    if (rc < 0 || !WIFEXITED(status) || WEXITSTATUS(status) || fseek(dest, 0, SEEK_END)) goto done;
+    long bytes = ftell(dest);
+    if (bytes <= 0 || (unsigned long)bytes > MAX_BODY_BYTES || fseek(dest, 0, SEEK_SET)) goto done;
+    result = ei_xmalloc((size_t)bytes + 1);
+    if (fread(result, 1, (size_t)bytes, dest) != (size_t)bytes) {
+        free(result);
+        result = NULL;
+    } else {
+        result[bytes] = '\0';
+    }
+done:
+    if (source) fclose(source);
+    if (dest) fclose(dest);
+    return result;
+}
