+static bool embed_token_array(ei_inference_service *service, const char *p, float *out,
+                              size_t *count, char *err, size_t len) {
+    int32_t ids[8192];
+    size_t n = 0;
+    if (!json_expect(&p, '[', err, len)) return false;
+    for (;;) {
+        skip_ws(&p);
+        if (n == sizeof ids / sizeof *ids) {
+            snprintf(err, len, "context_length_exceeded");
+            return false;
+        }
+        char *end = NULL;
+        errno = 0;
+        long id = strtol(p, &end, 10);
+        if (!isdigit((unsigned char)*p) || errno || id >= EI_VOCAB) {
+            snprintf(err, len, "invalid input token ID");
+            return false;
+        }
+        ids[n++] = (int32_t)id;
+        p = end;
+        skip_ws(&p);
+        if (*p == ']') break;
+        if (!json_expect(&p, ',', err, len)) return false;
+    }
+    *count = n;
+    return ei_inference_service_embed_tokens(service, ids, n, out, err, len);
+}
+
+static void handle_tokenize(int fd, const server_opts *opts, const char *body, bool keep_alive) {
+    const char *p = find_json_field(body, "content");
+    sv_string text = {0};
+    char err[128] = "tokenize requires string content";
+    if (!p || !parse_json_string(&p, &text, err, sizeof err)) {
+        openai_http_error(fd, 400, "Bad Request", err, "content", keep_alive);
+        return;
+    }
+    const char *add = find_json_field(body, "add_special");
+    const char *parse = find_json_field(body, "parse_special");
+    if (add) skip_ws(&add);
+    if (parse) skip_ws(&parse);
+    ei_tokens tokens;
+    ei_tokenize_spm(&opts->engine->tokenizer, text.s, text.len,
+                    add && !strncmp(add, "true", 4), !parse || !strncmp(parse, "true", 4), &tokens);
+    free(text.s);
+    const char *truncate = find_json_field(body, "truncate");
+    if (truncate) skip_ws(&truncate);
+    if (tokens.n > 8192 && truncate && !strncmp(truncate, "true", 4)) tokens.n = 8192;
+    if (tokens.n > 8192) {
+        ei_tokens_free(&tokens);
+        openai_http_error(fd, 400, "Bad Request", "context_length_exceeded", "content", keep_alive);
+        return;
+    }
+    sbuf result = {0};
+    sbuf_append_z(&result, "{\"tokens\":[");
+    for (size_t i = 0; i < tokens.n; i++) {
+        char row[32];
+        snprintf(row, sizeof row, "%s%d", i ? "," : "", tokens.ids[i]);
+        sbuf_append_z(&result, row);
+    }
+    sbuf_append_z(&result, "]}");
+    http_response(fd, 200, "OK", result.data, keep_alive);
+    ei_tokens_free(&tokens);
+    free(result.data);
+}
