+/// Enforce the repo-scoped allowlist (f9-02). When the allowlist is set and
+/// `repo` is not an exact member, refuse with 404 — deliberately not 403, so a
+/// forbidden repository is indistinguishable from one that does not exist, and
+/// clients cannot discover which repositories sit in the cache. The 404 is
+/// returned before any upstream fetch and before any cache read, so a denied
+/// repo can never leak objects even when its mirror is already materialized.
+fn check_repo_allowed(st: &AppState, repo: &str, kind: RequestKind) -> Option<Response> {
+    if st.allowlist.allows(repo) {
+        return None;
+    }
+    st.metrics.record_request(kind, Status::Rejected, "-");
+    Some(err(StatusCode::NOT_FOUND, "repository not found"))
+}
