+// SPDX-License-Identifier: Apache-2.0
+//! Repo-scoped authorization (f9-02).
+//!
+//! The proxy can hold an upstream credential for repositories it mirrors, so an
+//! operator wants the exact set of repository paths those requests may target.
+//! This module implements that allowlist as a small exact-match set whose
+//! semantics are written down once and tested, so every serving path (git
+//! info/refs, git upload-pack, git-LFS batch, git-LFS object) enforces the same
+//! decision.
+//!
+//! Semantics:
+//! - The allowlist is the set of exact repo paths (e.g. `mytecor/lattice`,
+//!   `group/team/foo.git`) in the same normalized form `repo::resolve` produces.
+//! - An empty allowlist means "serve anything" (the pre-f9-02 behavior), so
+//!   turning authorization off is a deliberate, explicit act and never a
+//!   half-configured default.
+//! - Matching is direct set membership: no prefixes, wildcards, or substring
+//!   suffix rules, so resetting upstream credential scope can never accidentally
+//!   widen to a whole namespace. A equals-or-suffix match is deliberately NOT
+//!   used - `a/b.git` must not authorize `a/b-other.git`.
+
+use std::collections::HashSet;
+
+#[derive(Debug, Clone)]
+pub struct Allowlist {
+    repos: HashSet<String>,
+    /// When false the allowlist is inert (empty), preserving upstream behavior.
+    enabled: bool,
+}
+
+impl Allowlist {
+    /// Build an allowlist from the configured repo paths. An empty list disables
+    /// enforcement entirely (matches upstream's serve-anything behavior).
+    pub fn new(paths: &[String]) -> Self {
+        Self {
+            repos: paths.iter().map(|p| p.trim().to_string()).collect(),
+            enabled: !paths.is_empty(),
+        }
+    }
+
+    /// Whether a request for `repo` (as resolved by `repo::resolve`) is allowed.
+    /// Requires the exact normalized path; see the module docs for why suffix
+    /// rules are deliberately rejected.
+    pub fn allows(&self, repo: &str) -> bool {
+        if !self.enabled {
+            return true;
+        }
+        self.repos.contains(repo)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn empty_allowlist_serves_everything() {
+        let allowed = Allowlist::new(&[]);
+        assert!(allowed.allows("anything/at/all.git"));
+        assert!(allowed.allows("mytecor/lattice"));
+    }
+
+    #[test]
+    fn exact_membership_allows_the_allowed_repo() {
+        let allowed = Allowlist::new(&["mytecor/lattice".to_string()]);
+        assert!(allowed.allows("mytecor/lattice"));
+    }
+
+    #[test]
+    fn wrong_repo_is_refused() {
+        let allowed = Allowlist::new(&["mytecor/lattice".to_string()]);
+        assert!(!allowed.allows("mytecor/other"));
+        assert!(!allowed.allows("other/lattice"));
+    }
+
+    #[test]
+    fn suffix_and_prefix_do_not_widen() {
+        // `a/b.git` must not authorize `a/b-other.git` (suffix confusion), and
+        // `mytecor` must not authorize any `mytecor/*` namespace (no prefix
+        // rules) - the allowlist is exact repo paths only.
+        let allowed = Allowlist::new(&["a/b.git".to_string(), "mytecor".to_string()]);
+        assert!(!allowed.allows("a/b-other.git"));
+        assert!(!allowed.allows("mytecor/lattice"));
+    }
+
+    #[test]
+    fn trailing_dot_git_forms_are_distinct() {
+        // The resolved repo name keeps whatever form the path had; `foo.git` and
+        // `foo` are different repos and must not alias each other.
+        let allowed = Allowlist::new(&["foo.git".to_string()]);
+        assert!(allowed.allows("foo.git"));
+        assert!(!allowed.allows("foo"));
+    }
+
+    #[test]
+    fn whitespace_is_trimmed() {
+        let allowed = Allowlist::new(&["  mytecor/lattice  ".to_string()]);
+        assert!(allowed.allows("mytecor/lattice"));
+    }
+}
