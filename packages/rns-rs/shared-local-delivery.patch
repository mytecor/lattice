+#[test]
+fn test_header1_delivery_to_attached_local_client() {
+    for from_local in [false, true] {
+        for target_local in [false, true] {
+            for packet_type in [constants::PACKET_TYPE_LINKREQUEST, constants::PACKET_TYPE_DATA] {
+                let mut engine = TransportEngine::new(make_config(true));
+                engine.register_interface(if from_local { make_local_client_interface(1) }
+                    else { make_interface(1, constants::MODE_FULL) });
+                engine.register_interface(if target_local { make_local_client_interface(2) }
+                    else { make_interface(2, constants::MODE_FULL) });
+                let destination = [0xB7; 16];
+                engine.upsert_path_destination(destination,
+                    make_path_entry(1000.0, 0, InterfaceId(2), destination), 1000.0);
+                let packet = RawPacket::pack(PacketFlags {
+                    header_type: constants::HEADER_1,
+                    context_flag: constants::FLAG_UNSET,
+                    transport_type: constants::TRANSPORT_BROADCAST,
+                    destination_type: constants::DESTINATION_SINGLE,
+                    packet_type,
+                }, 0, &destination, None, constants::CONTEXT_NONE, &[0x22; 64]).unwrap();
+                let mut rng = rns_crypto::FixedRng::new(&[0x33; 32]);
+                let actions = engine.handle_inbound(InboundFrame {
+                    raw: &packet.raw, iface: InterfaceId(1), now: 1001.0,
+                    rx: RxMetadata { rssi: None, snr: None },
+                }, &mut rng);
+                let forwarded = actions.iter().find_map(|action| match action {
+                    TransportAction::SendOnInterface { interface, raw } if *interface == InterfaceId(2)
+                        => Some(RawPacket::unpack(raw).unwrap()),
+                    _ => None,
+                });
+                assert_eq!(forwarded.is_some(), target_local,
+                    "header-1 final delivery from_local={from_local} target_local={target_local}");
+                if let Some(forwarded) = forwarded {
+                    assert_eq!(forwarded.flags.header_type, constants::HEADER_1);
+                    assert_eq!(forwarded.destination_hash, destination);
+                    assert_eq!(forwarded.packet_hash, packet.packet_hash);
+                    assert_eq!(forwarded.hops, if from_local { 0 } else { 1 });
+                }
+            }
+        }
+    }
+}
