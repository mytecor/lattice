+// Child output and exit notifications can remain queued after a link closes.
+// Transport failures here belong to that session, not to the listener loop.
+fn handle_listener_process_event(
+    transport: &dyn RnshTransport,
+    sessions: &mut HashMap<[u8; 16], ListenerSession>,
+    event: RnshEvent,
+) {
+    match event {
+        RnshEvent::ProcessOutput {
+            link_id,
+            stream_id,
+            data,
+        } => {
+            if !sessions
+                .get(&link_id)
+                .is_some_and(|s| s.state == ListenerState::Running)
+            {
+                return;
+            }
+            if let Err(err) = send_stream_chunks(transport, link_id, stream_id, &data, false) {
+                log::warn!(
+                    "Closing rnsh session {} after output send failed: {err}",
+                    prettyhexrep(&link_id)
+                );
+                if let Some(mut session) = sessions.remove(&link_id) {
+                    if let Some(process) = &mut session.process {
+                        process.terminate();
+                    }
+                }
+                let _ = transport.teardown_rnsh_link(link_id);
+            }
+        }
+        RnshEvent::ProcessExited { link_id, code } => {
+            let Some(session) = sessions.remove(&link_id) else {
+                return;
+            };
+            if session.state != ListenerState::Running {
+                return;
+            }
+            // The waiter has already reaped the child; do not signal its PID.
+            let result = send_stream_chunks(transport, link_id, STREAM_STDOUT, &[], true)
+                .and_then(|()| send_message(transport, link_id, &RnshMessage::CommandExited(code)));
+            if let Err(err) = result {
+                log::warn!(
+                    "Closing rnsh session {} after exit send failed: {err}",
+                    prettyhexrep(&link_id)
+                );
+                let _ = transport.teardown_rnsh_link(link_id);
+            }
+        }
+        RnshEvent::LinkClosed(link_id) => {
+            if let Some(mut session) = sessions.remove(&link_id) {
+                if let Some(process) = &mut session.process {
+                    process.terminate();
+                }
+            }
+        }
+        _ => {}
+    }
+}
